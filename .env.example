# ---- core (phase 00) ----
DATABASE_URL=sqlite+aiosqlite:///./data/analytica.db
TIMEZONE=Europe/Zurich
LOG_LEVEL=INFO

# ---- Habitica (phase 01) ----
HABITICA_USER_ID=                # Habitica -> Settings -> Site Data -> User ID
HABITICA_API_TOKEN=              # same page -> API Token (keep secret)

# ---- Telegram (phase 02) ----
TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_ALLOWED_USER_IDS=       # your numeric id, comma-separated for more; from @userinfobot
TELEGRAM_MODE=polling            # polling (local dev) | webhook (VPS)

# ---- public URL + webhooks (phase 01 for Habitica, 02 for Telegram; real values in phase 05) ----
PUBLIC_BASE_URL=                 # https://bot.example.com - leave empty until the VPS has a domain
WEBHOOK_SECRET=                  # random string, e.g. `openssl rand -hex 24`; used in both webhook paths

# ---- models, all via OpenRouter (phases 03-04) ----
OPENROUTER_API_KEY=
LLM_STRONG_MODEL=z-ai/glm-5.3
LLM_CHEAP_MODEL=deepseek/deepseek-v4-flash
ASR_MODEL=qwen/qwen3-asr-flash               # verify id at build time
TTS_MODEL=fishaudio/s2.1-pro                 # verify id and voice parameter at build time
TTS_VOICE=b347db033a6549378b48d00acb0d06cd   # Selene, used for all languages

# ---- sessions and context (phase 03) ----
SESSION_IDLE_QUICK_MIN=15
SESSION_IDLE_PLANNING_MIN=120
SESSION_TOKEN_BUDGET=24000

# ---- schedule (phase 05) ----
REMINDER_TIME=21:00
WEEKLY_REPORT=sun 19:00

# ---- Google Calendar (phase 09) ----
GOOGLE_CLIENT_SECRETS_PATH=./data/google_client_secrets.json
GOOGLE_TOKEN_PATH=./data/google_token.json
PLAN_HOURS=09:00-19:00
PLAN_SLOT_MINUTES=60
PLAN_CHECKIN_DELAY_MIN=10
